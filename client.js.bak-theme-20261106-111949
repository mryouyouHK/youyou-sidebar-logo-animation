.dsla-row-bot-avatar .bt-eye-happy{transition:opacity .12s ease-out}
.dsla-row-bot-avatar .dsla-row-bot-avatar-img{transition:rotate .5s cubic-bezier(.34,1.56,.64,1),translate .5s cubic-bezier(.34,1.56,.64,1),scale .3s ease-out}
