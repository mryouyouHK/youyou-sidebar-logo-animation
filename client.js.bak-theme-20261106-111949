@keyframes dsla-bubble-blink{0%,100%{opacity:.55;transform:translateY(0)}50%{opacity:1;transform:translateY(-1px)}}
@media (prefers-reduced-motion:reduce){
  [data-chat-flow-kind="assistant-step"]:has([data-streaming])::before,
  [data-chat-flow-kind="assistant-step"]:has([data-streaming])::after{animation:none}}
/* Waiting-for-subagent countdown: black card flip clock below the tool card. */
[data-chat-flow-kind="assistant-step"] [data-slot="conversation.chat.node"] > div > [class*="_body"] :where(table){width:max-content;min-width:100%;max-width:none;border-collapse:collapse}
[data-chat-flow-kind="assistant-step"] [data-slot="conversation.chat.node"] > div > [class*="_body"]::-webkit-scrollbar{height:8px}
[data-chat-flow-kind="assistant-step"] [data-slot="conversation.chat.node"] > div > [class*="_body"]::-webkit-scrollbar-thumb{border-radius:999px;background:color-mix(in srgb,var(--dsw-alias-label-primary) 22%,transparent)}
[data-chat-flow-kind="assistant-step"] [data-slot="conversation.chat.node"] > div > [class*="_body"]::-webkit-scrollbar-track{background:transparent}
[data-chat-flow-kind="assistant-step"] [data-slot="conversation.chat.node"] > div > [class*="_body"]:focus-visible{outline:2px solid var(--dsw-alias-state-business-primary);outline-offset:2px}
[data-chat-flow-kind="assistant-step"] [data-slot="conversation.chat.node"] > div > [class*="_body"] :where(pre,code){max-width:100%}
.dsla-flip-clock{display:inline-flex;align-items:center;gap:10px;margin:8px 0 4px 22px;padding:0;background:transparent}
.dsla-flip-icon{display:inline-flex;perspective:80px;color:var(--dsw-alias-brand-primary,#4d6bfe);margin-right:2px}
.dsla-flip-icon--spin svg{transform-origin:50% 50%;animation:dsla-hourglass-turn 2.4s ease-in-out infinite}
@keyframes dsla-hourglass-turn{0%,42%{transform:rotateX(0deg)}58%,100%{transform:rotateX(180deg)}}
.dsla-flip-cards{display:inline-flex;align-items:center;gap:8px;perspective:240px}
.dsla-flip-card{position:relative;display:inline-block;width:62px;height:70px;border-radius:10px;background:#0a0a0c;box-shadow:0 3px 8px rgba(0,0,0,.35),inset 0 0 0 1px rgba(255,255,255,.07);transform-style:preserve-3d;perspective:240px}
.dsla-flip-half{position:absolute;left:0;right:0;height:50%;overflow:hidden;background:#0a0a0c}
