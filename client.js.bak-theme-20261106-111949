.dsla-clear{flex:none;display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;padding:0;border:0;border-radius:6px;background:transparent;color:var(--dsw-alias-label-tertiary);cursor:pointer;transition:background .15s ease,color .15s ease}
.dsla-clear:hover{background:var(--dsw-alias-interactive-bg-hover,var(--dsw-alias-bg-layer-2));color:var(--dsw-alias-label-primary)}
/* A collapsed rail shows the brand mark in the window chrome, where it can
   overlap the traffic lights; keep only the shipped panel/expand affordance. */
[data-platform="darwin"] [class*="collapsed"] .dsla-mark-link{display:none}
.dsla-settings-button:hover,.dsla-settings-button[data-open="true"]{background:var(--dsw-alias-interactive-bg-hover,var(--dsw-alias-bg-layer-2));color:var(--dsw-alias-label-primary)}
div:has(> div > [data-slot="sidebar.footer.action"]){position:relative}
/* Wide footer dock: exactly the notification-center button geometry. */
.dsla-settings-button--dock{position:relative;width:28px;height:28px;border:0;outline:none;border-radius:var(--dsw-radius-sm);background:transparent}
.dsla-settings-button--dock[data-wide="true"]{
