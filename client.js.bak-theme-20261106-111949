}
.dsla-settings-button--dock:hover,.dsla-settings-button--dock[data-open="true"]{background:var(--dsw-alias-interactive-bg-hover,var(--dsw-alias-bg-layer-2))}
.dsla-settings-panel{position:fixed;z-index:1200;left:14px;bottom:66px;width:272px;box-sizing:border-box;border-radius:16px;overflow:hidden;
  background:color-mix(in srgb,var(--dsw-alias-bg-base) 82%,transparent);
