.dsla-settings-head{display:flex;align-items:center;justify-content:space-between;padding:12px 14px 4px;font-weight:600;font-size:13px}
.dsla-settings-close{appearance:none;width:22px;height:22px;padding:0;border:0;border-radius:7px;background:transparent;color:var(--dsw-alias-label-tertiary);font-size:15px;line-height:1;cursor:pointer}
.dsla-settings-close:hover{color:var(--dsw-alias-label-primary);background:color-mix(in srgb,var(--dsw-alias-label-primary) 8%,transparent)}
.dsla-settings-body{padding:4px 8px 8px}
.dsla-settings-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 8px;border-radius:10px;cursor:pointer;transition:background .15s ease}
.dsla-settings-row:hover{background:color-mix(in srgb,var(--dsw-alias-label-primary) 6%,transparent)}
.dsla-settings-row span:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dsla-settings-row input[type="checkbox"]{position:absolute;opacity:0;width:0;height:0;pointer-events:none}
