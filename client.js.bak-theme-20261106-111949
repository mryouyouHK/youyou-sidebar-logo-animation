html[data-dsla-motion="off"] [data-composer-card]:has([data-dsla-composer-rainbow]){
  box-shadow:var(--dsw-elevation-soft),0 0 0 1px rgba(130,185,255,.30),0 0 22px 6px rgba(120,180,255,.18)}
.dsla-settings-button{appearance:none;position:relative;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;border:0;outline:none;box-shadow:none;border-radius:var(--dsw-radius-sm);background:transparent;color:var(--dsw-alias-label-secondary);cursor:pointer;flex:none;transition:background .15s ease,color .15s ease}
