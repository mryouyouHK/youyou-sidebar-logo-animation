/* Menus opened from the composer (prompt / model switches) win over all card
   effects: the ring, breathing and pulse animations stop while a menu is open. */
[data-composer-card] [data-slot="conversation.input.overlay"]{z-index:60}
[data-composer-card] [role="menu"],
[data-composer-card] [role="listbox"],
[data-composer-card] [role="dialog"]{z-index:200}
[data-composer-card]:has([role="menu"],[role="listbox"],[role="dialog"],[aria-expanded="true"][aria-haspopup]){animation:none!important}
[data-composer-card]:has([role="menu"],[role="listbox"],[role="dialog"],[aria-expanded="true"][aria-haspopup])::after{display:none!important}
body:has([role="menu"],[role="listbox"],[role="dialog"],[aria-expanded="true"][aria-haspopup]) [data-composer-card]::after,
body:has([role="menu"],[role="listbox"],[role="dialog"],[aria-expanded="true"][aria-haspopup]) .dsc-hero-chat-card::before{display:none!important}
body:has([role="menu"],[role="listbox"],[role="dialog"],[aria-expanded="true"][aria-haspopup]) [data-composer-card],
