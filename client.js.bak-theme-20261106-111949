.dsla-switch-track{box-sizing:border-box;width:34px;height:19px;border-radius:999px;background:color-mix(in srgb,var(--dsw-alias-label-tertiary) 28%,transparent);transition:background .2s ease}
.dsla-switch-thumb{position:absolute;top:2px;left:2px;width:15px;height:15px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.3);transition:transform .2s cubic-bezier(.3,.9,.4,1)}
.dsla-settings-row input:checked+.dsla-switch-track{background:var(--dsw-alias-state-business-primary)}
.dsla-settings-row input:checked+.dsla-switch-track+.dsla-switch-thumb{transform:translateX(15px)}
.dsla-settings-row input:focus-visible+.dsla-switch-track{outline:2px solid var(--dsw-alias-state-business-primary);outline-offset:2px}
.dsla-settings-section{margin:10px 8px 2px;color:var(--dsw-alias-label-tertiary);font-size:11px;font-weight:600;letter-spacing:.06em}
.dsla-settings-select{box-sizing:border-box;font:inherit;font-size:12px;color:var(--dsw-alias-label-primary);background:var(--dsw-alias-bg-layer-2);border:1px solid var(--dsw-alias-border-l1);border-radius:8px;padding:4px 8px;cursor:pointer;flex:none}
.dsla-color-row{cursor:default}
.dsla-color-controls{display:flex;align-items:center;gap:6px;flex:none}
.dsla-color-input{appearance:none;-webkit-appearance:none;width:30px;height:22px;padding:0;border:0;border-radius:6px;background:transparent;cursor:pointer}
.dsla-color-input::-webkit-color-swatch-wrapper{padding:0}
.dsla-color-input::-webkit-color-swatch{border:1px solid var(--dsw-alias-border-l1);border-radius:6px}
.dsla-color-auto{appearance:none;border:0;background:transparent;color:var(--dsw-alias-label-tertiary);font-size:11px;line-height:16px;padding:2px 5px;border-radius:5px;cursor:pointer}
.dsla-color-auto:hover{color:var(--dsw-alias-label-primary);background:color-mix(in srgb,var(--dsw-alias-label-primary) 8%,transparent)}
.dsla-model-preview{width:26px;height:26px;border-radius:50%;background:var(--dsla-model-avatar) center/cover no-repeat;background-color:var(--dsw-alias-bg-skeleton);box-shadow:0 0 0 1px var(--dsw-alias-border-l1);flex:none}
.dsla-model-file{display:none}
/* Chat conversation: dialog bubbles with avatars (model left, user right). */
[data-chat-flow-kind="user"],[data-chat-flow-kind="steering"]{position:relative;padding-right:44px}
[data-chat-flow-kind="user"]::after,[data-chat-flow-kind="steering"]::after{content:"";position:absolute;right:2px;top:2px;width:30px;height:30px;border-radius:50%;background:var(--dsla-user-avatar,url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='12.4' r='5.1' fill='%237f8fae'/><path d='M5.8 27.2c1.1-5.7 5.3-8.6 10.2-8.6s9.1 2.9 10.2 8.6' fill='%237f8fae'/></svg>")) center/cover no-repeat;box-shadow:0 0 0 1px var(--dsw-alias-border-l1);pointer-events:none;background-color:var(--dsla-avatar-bg,var(--dsw-alias-bg-skeleton))}
[data-chat-flow-kind="assistant-step"]:has([class*="_body"] :is(p,pre,table,ul,ol,blockquote,img,h1,h2,h3,h4,h5,h6,code)) [data-slot="conversation.chat.node"] > div > [class*="_body"]{box-sizing:border-box;width:fit-content;max-width:100%;min-width:0;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:thin;overflow-wrap:anywhere;padding:10px 16px;border-radius:18px;background:var(--dsw-alias-bg-layer-2,var(--dsw-alias-interactive-bg-hover,var(--dsw-alias-bg-layer-1)));background:color-mix(in srgb,var(--dsw-alias-label-primary) 8%,var(--dsw-alias-bg-base));background:var(--dsla-bubble-bg,light-dark(#ececec,#2b2e34))}
[data-chat-flow-kind="assistant-step"]:has([class*="_body"] :is(p,pre,table,ul,ol,blockquote,img,h1,h2,h3,h4,h5,h6,code)){position:relative;box-sizing:border-box;padding-left:46px;align-self:flex-start;max-width:96%}
[data-chat-flow-kind="assistant-step"]:has([class*="_body"] :is(p,pre,table,ul,ol,blockquote,img,h1,h2,h3,h4,h5,h6,code))::before{content:"";position:absolute;left:0;top:2px;width:34px;height:34px;border-radius:50%;background:var(--dsla-model-avatar,url("data:image/jpeg;base64,")) center/cover no-repeat;box-shadow:0 0 0 1px var(--dsw-alias-border-l1);pointer-events:none}
/* While the model is answering, the avatar peeks up to look at the reply,
   with a small "typing" speech cloud floating above it. */
[data-chat-flow-kind="assistant-step"]:has([data-streaming])::before{animation:dsla-avatar-peek 1.4s ease-in-out infinite}
@keyframes dsla-avatar-peek{
