.dsla-row-bot-avatar-img{width:100%;height:100%;object-fit:cover;display:block;border-radius:50%}
.dsla-row-bot-avatar-svg{display:block;line-height:0}
.dsla-row-bot-avatar-svg svg{width:16px;height:16px;display:block}
