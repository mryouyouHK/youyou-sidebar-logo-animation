.dsla-hero-logo:hover svg{animation:dsla-hero-swim 1.1s ease-in-out infinite}
@keyframes dsla-hero-swim{
  0%,100%{transform:translateY(0) scaleX(1) scaleY(1)}
  35%{transform:translateY(-2px) scaleX(1.05) scaleY(.955)}
  70%{transform:translateY(1px) scaleX(.96) scaleY(1.03)}}
@media (prefers-reduced-motion:reduce){.dsla-hero-logo:hover svg{animation:none}}
/* Per-location motion switches (mirrored from localStorage onto <html>). */
html[data-dsla-brand="off"] .dsla-mark[data-running="true"] .dsla-whale,
html[data-dsla-brand="off"] .dsla-name[data-running="true"] .dsla-name-sheen{animation:none!important;transform:none!important}
html[data-dsla-header="off"] .dsla-header-mark{display:none}
html[data-dsla-composer="off"] [data-composer-card]{animation:none!important;background-image:none!important}
html[data-dsla-composer="off"] [data-composer-card]:not([class*="cardWorkspaceTrigger"])::before,
html[data-dsla-composer="off"] [data-composer-card]:not([class*="cardWorkspaceTrigger"])::after{content:none!important;animation:none!important}
html[data-dsla-ambient="off"] [data-composer-seat]::before,
html[data-dsla-ambient="off"] [data-composer-seat]::after{content:none!important}
html[data-dsla-cursor="off"] .dsla-blend-cursor{display:none}
/* 流光动效关闭 = 保留彩虹配色，但停止动起来。
   这几个动画每帧都在重绘整块输入框（渐变位移、阴影呼吸、打字脉冲），是本插件
   最主要的持续发热源；停住之后画面静止、配色不变，几乎看不出差别，开销归零。 */
html[data-dsla-motion="off"] [data-composer-card],
html[data-dsla-motion="off"] [data-composer-card]::after,
html[data-dsla-motion="off"] [data-composer-seat]::before,
html[data-dsla-motion="off"] [data-composer-seat]::after{animation:none!important}
html[data-dsla-motion="off"] [data-composer-card] button[class*="_primary"]{animation:none!important}
